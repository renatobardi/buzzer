# Copy to /etc/buzzer/environment (0640 root:buzzer). Never commit a filled-in
# copy: BUZZ_PRIVATE_KEY is the agent's identity on the relay.

# The agent's Nostr secret key. Generated by the Buzz Desktop agent setup, or
# by `buzz-admin generate-key`. Its pubkey must be a relay member first:
#   BUZZ_RELAY_PRIVATE_KEY=<relay signing key> buzz-admin add-member --pubkey <agent pubkey>
BUZZ_PRIVATE_KEY=

# Relay WebSocket URL. ws:// is fine over a private network; use wss:// across
# the public internet.
BUZZ_RELAY_URL=

# Claude Code as the ACP runtime.
BUZZ_ACP_AGENT_COMMAND=claude-agent-acp

# Credentials for Claude Code itself — set exactly one.
#ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=

# Only if the relay enforces token auth.
#BUZZ_API_TOKEN=

# Uncomment with --with-browser to give the agent a headless browser.
#BUZZ_ACP_MCP_COMMAND=/usr/local/bin/playwright-mcp
